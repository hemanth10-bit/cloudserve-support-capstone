# Copy this file to .env and fill in your own values. .env is git-ignored; never commit a real key.

# Model access (OpenRouter free tier). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db
CACHE_PATH=./storage/llm_cache.sqlite

LOG_LEVEL=INFO
# Provisional. Replaced by the value derived from the development-set sweep (see docs/decisions.md).
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5
# Cosine similarity floor for retrieved passages, chosen from the dev-set sweep (docs/decisions.md D-05).
RETRIEVAL_MIN_SCORE=0.40
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
